<Project Sdk="Godot.NET.Sdk/4.5.1" InitialTargets="CheckDependencyPaths">
    <!-- Sibling sample project for MultiEnchantmentMod's v2 stacking API. Builds compilable
         reference implementations of every public registration tier and ships a .pck containing
         the localization tables for the sample enchantment classes. Defaults to NOT copying
         into the game's mods folder — run with -p:InstallSamples=true to install it as an
         actual game mod for live testing. -->

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <InstallSamples Condition="'$(InstallSamples)' == ''">false</InstallSamples>
        <NoWarn>$(NoWarn);MSB3270</NoWarn>
        <!-- The main mod's packages/ folder lives one directory up; the BepInEx publicizer
             NuGet ships .cs.uid Godot metadata that we must NOT compile. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);**/*.uid;**/packages/**</DefaultItemExcludes>
        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
    </PropertyGroup>

    <!-- Mirror the main mod's STS2/Godot path discovery so we don't have to duplicate registry
         lookups. The PropertyGroup blocks are intentionally copied verbatim from the main csproj. -->

    <PropertyGroup>
        <IsWindows>false</IsWindows>
        <IsLinux>false</IsLinux>
        <IsOSX>false</IsOSX>
        <IsWindows Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</IsWindows>
        <IsLinux Condition="$([MSBuild]::IsOSPlatform('Linux'))">true</IsLinux>
        <IsOSX Condition="$([MSBuild]::IsOSPlatform('OSX'))">true</IsOSX>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsWindows)' == 'true'">
        <AutoSteamPath>$(registry:HKEY_CURRENT_USER\Software\Valve\Steam@SteamPath)\steamapps</AutoSteamPath>
        <SteamLibraryPath Condition="Exists('$(AutoSteamPath)/common/Slay the Spire 2')">$(AutoSteamPath)</SteamLibraryPath>
        <SteamLibraryPath Condition="'$(SteamLibraryPath)' == ''">C:/Program Files (x86)/Steam/steamapps</SteamLibraryPath>

        <GodotPath>C:/megadot/MegaDot_v4.5.1-stable_mono_win64.exe</GodotPath>
        <Sts2Path>$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
        <ModsPath>$(Sts2Path)/mods/</ModsPath>
        <Sts2DataDir>$(Sts2Path)/data_sts2_windows_x86_64</Sts2DataDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsLinux)' == 'true'">
        <SteamLibraryPath Condition="'$(SteamLibraryPath)' == ''">$(HOME)/.local/share/Steam/steamapps</SteamLibraryPath>
        <GodotPath Condition="'$(GodotPath)' == ''">$(SteamLibraryPath)/common/Godot Engine/godot.x11.opt.tools.64</GodotPath>
        <Sts2Path>$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
        <ModsPath>$(Sts2Path)/mods/</ModsPath>
        <Sts2DataDir>$(Sts2Path)/data_sts2_linuxbsd_x86_64</Sts2DataDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsOSX)' == 'true'">
        <SteamLibraryPath Condition="'$(SteamLibraryPath)' == ''">$(HOME)/Library/Application Support/Steam/steamapps</SteamLibraryPath>
        <GodotPath Condition="'$(GodotPath)' == ''">$(HOME)/Applications/Godot_mono.app/Contents/MacOS/Godot</GodotPath>
        <Sts2Path>$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
        <ModsPath>$(Sts2Path)/SlayTheSpire2.app/Contents/MacOS/mods/</ModsPath>
        <Sts2DataDir>$(Sts2Path)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_x86_64</Sts2DataDir>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(Sts2DataDir)')">
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <!-- Samples deliberately consume only public sts2 surface; no Publicize. The main mod
             gets publicized via its own csproj, and ProjectReference brings that publicized
             assembly along for Samples to use. -->
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MultiEnchantmentMod.csproj"/>
    </ItemGroup>

    <!-- Register loc files with the STS analyzer so STS002 stays quiet and pre-flight validation
         catches missing keys at build time. The Godot project export (export_presets.cfg) bundles
         the same folder into the .pck so the runtime LocManager can load them via res://. -->
    <ItemGroup>
        <AdditionalFiles Include="MultiEnchantmentMod.Samples/localization/**/*.json"/>
    </ItemGroup>

    <!-- Resource subfolder (mirrors main mod's pattern): everything under
         MultiEnchantmentMod.Samples/<modid>/ is included as Godot resources for the pck export
         but excluded from C# compilation. -->
    <ItemGroup>
        <Compile Remove="MultiEnchantmentMod.Samples/**"/>
        <EmbeddedResource Remove="MultiEnchantmentMod.Samples/**"/>
        <None Include="MultiEnchantmentMod.Samples.json"/>
        <None Include="project.godot"/>
        <None Include="MultiEnchantmentMod.Samples/**"/>
    </ItemGroup>

    <Target Name="CheckDependencyPaths">
        <Error
                Text=" Slay the Spire 2 data not found at path '$(Sts2DataDir)'"
                Condition="'$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)')"/>
    </Target>

    <Target Name="CopyToModsFolderOnBuild" AfterTargets="PostBuildEvent" Condition="'$(InstallSamples)' == 'true'">
        <Message Text="Copying samples .dll and manifest to mods folder." Importance="high"/>
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsPath)$(MSBuildProjectName)/"/>
        <Copy SourceFiles="MultiEnchantmentMod.Samples.json" DestinationFolder="$(ModsPath)$(MSBuildProjectName)/"/>
    </Target>

    <Target Name="SamplesInstallReminder" AfterTargets="PostBuildEvent" Condition="'$(InstallSamples)' != 'true'">
        <Message Text="Samples assembly built but NOT installed. Use 'dotnet build -p:InstallSamples=true' to copy the .dll + manifest, and 'dotnet publish -p:InstallSamples=true' to also export the .pck for localization." Importance="high"/>
    </Target>

    <Target Name="GodotPublish" AfterTargets="Publish" Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)') and '$(IsInnerGodotExport)' != 'true' and '$(InstallSamples)' == 'true'">
        <Message Text="Exporting Samples Godot .pck to mods folder" Importance="high"/>
        <Exec Command="&quot;$(GodotPath)&quot; --headless --export-pack &quot;BasicExport&quot; &quot;$(ModsPath)$(MSBuildProjectName)/$(MSBuildProjectName).pck&quot;"
              EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1"
              ContinueOnError="WarnAndContinue"/>
    </Target>

    <Target Name="GodotPublishSkipped" AfterTargets="Publish" Condition="('$(GodotPath)' == '' or !Exists('$(GodotPath)')) and '$(InstallSamples)' == 'true'">
        <Message Text="Skipping Samples .pck export because GodotPath is not configured." Importance="high"/>
    </Target>
</Project>

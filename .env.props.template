<!-- Copy this file to .env.props and fill in your PostHog credentials. -->
<!-- .env.props is gitignored and will not be committed. -->
<Project>
    <PropertyGroup>
        <!-- US Cloud: https://us.i.posthog.com   EU Cloud: https://eu.i.posthog.com -->
        <PostHogHost>https://us.i.posthog.com</PostHogHost>
        <!-- Project API Key (phc_...), write-only, safe to embed. -->
        <PostHogProjectKey>phc_YOUR_PROJECT_KEY</PostHogProjectKey>
    </PropertyGroup>
</Project>

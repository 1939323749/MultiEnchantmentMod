<!-- Copy this file to .env.props and fill in your Axiom credentials. -->
<!-- .env.props is gitignored and will not be committed. -->
<Project>
    <PropertyGroup>
        <!-- Axiom API host. US: https://api.axiom.co   EU: https://api.eu.axiom.co -->
        <AxiomDomain>https://api.axiom.co</AxiomDomain>
        <!-- Target dataset name (created in the Axiom UI). -->
        <AxiomDataset>multienchantmentmod</AxiomDataset>
        <!-- API token (xaat-...) with ingest permission on the dataset above. -->
        <AxiomToken>xaat-YOUR_API_TOKEN</AxiomToken>
    </PropertyGroup>
</Project>
